{
  "name": "Reader example — عنصر RSS جديد → رسالة Telegram",
  "flow": [
    {
      "id": 1,
      "module": "rss:TriggerNewArticle",
      "version": 4,
      "parameters": {
        "url": "https://example.com/feed/",
        "maxResults": 10,
        "username": "",
        "password": "",
        "include": [],
        "gzip": true
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch new feed items"
        },
        "interface": [
          {
            "name": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "name": "url",
            "type": "url",
            "label": "URL"
          },
          {
            "name": "guid",
            "type": "text",
            "label": "GUID"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "datastore:ExistRecord",
      "version": 1,
      "parameters": {},
      "mapper": {
        "key": "rss:{{ifempty(1.guid; 1.url)}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Check duplicate"
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key",
            "required": true
          }
        ],
        "interface": [
          {
            "name": "exist",
            "type": "boolean",
            "label": "Exists"
          }
        ]
      },
      "filter": {
        "name": "Valid approved content",
        "conditions": [
          [
            {
              "a": "{{1.title}}",
              "o": "exist"
            },
            {
              "a": "{{1.title}}",
              "o": "text:notequal",
              "b": ""
            },
            {
              "a": "{{1.url}}",
              "o": "text:startwith",
              "b": "https://"
            }
          ]
        ]
      }
    },
    {
      "id": 3,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {},
      "mapper": {
        "key": "rss:{{ifempty(1.guid; 1.url)}}",
        "overwrite": false,
        "data": {
          "state": "pending",
          "destination_id": "",
          "updated_at": "{{now}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Reserve before action"
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key",
            "required": true
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "label": "Overwrite an existing record",
            "required": true
          },
          {
            "name": "data",
            "type": "collection",
            "label": "Record",
            "spec": [
              {
                "name": "state",
                "type": "text",
                "label": "State"
              },
              {
                "name": "destination_id",
                "type": "text",
                "label": "Destination ID"
              },
              {
                "name": "updated_at",
                "type": "date",
                "label": "Updated at"
              }
            ]
          }
        ]
      },
      "filter": {
        "name": "Not already reserved",
        "conditions": [
          [
            {
              "a": "{{2.exist}}",
              "o": "boolean:equal",
              "b": false
            }
          ]
        ]
      }
    },
    {
      "id": 4,
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "chatId": "",
        "text": "{{substring(1.title; 0; 500)}}\n{{1.url}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Send title and link"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:telegram",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "chatId",
            "type": "text",
            "label": "Chat ID",
            "required": true
          },
          {
            "name": "text",
            "type": "text",
            "label": "Text",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "datastore:UpdateRecord",
      "version": 1,
      "parameters": {},
      "mapper": {
        "key": "rss:{{ifempty(1.guid; 1.url)}}",
        "upsert": false,
        "overwriteArrays": false,
        "data": {
          "state": "sent",
          "destination_id": "{{4.message_id}}",
          "updated_at": "{{now}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Save confirmed receipt"
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key",
            "required": true
          },
          {
            "name": "upsert",
            "type": "boolean",
            "label": "Insert missing record",
            "required": true
          },
          {
            "name": "overwriteArrays",
            "type": "boolean",
            "label": "Overwrite arrays",
            "required": true
          },
          {
            "name": "data",
            "type": "collection",
            "label": "Record",
            "spec": [
              {
                "name": "state",
                "type": "text",
                "label": "State"
              },
              {
                "name": "destination_id",
                "type": "text",
                "label": "Destination ID"
              },
              {
                "name": "updated_at",
                "type": "date",
                "label": "Updated at"
              }
            ]
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "notes": [
      {
        "moduleIds": [
          1,
          2,
          3,
          4,
          5
        ],
        "content": "<h3>TechMouad · Setup before activation</h3><ol><li>أنشئ سيناريو جديداً فارغاً في Make، ثم اختر More → Import blueprint وارفع ملف make-blueprint.json. احفظ الخطة TXT كدليل إعداد منفصل.</li><li>افتح كل وحدة وحدد اتصالاتك داخل Make فقط. لا يحتوي الملف على توكن أو اتصال أو Data store من حساب TechMouad.</li><li>أنشئ Data store مخصصاً لهذا السيناريو والمصدر، بحقلَي النص state وdestination_id وحقل التاريخ updated_at. المفتاح Key مدمج في Make. اختر المخزن نفسه في الوحدات 2 و3 و5، ثم احفظ كل وحدة وأعد فحص ربط الحقول.</li><li>حدد رابط التغذية في الوحدة 1، واختر Choose where to start → From now on، ثم حدد Chat ID في الوحدة 4.</li><li>الوحدة 4 ترسل عنواناً ورابطاً كنص عادي دون تنسيق Markdown أو HTML.</li><li>الجدولة لا تنتقل في ملف Blueprint: اضبطها داخل Make على كل 15 دقيقة، وتحقق من المنطقة الزمنية UTC في إعدادات المنظمة ومن توفر الفترة في خطتك.</li><li>أبقِ Sequential processing مفعلاً. حجز pending يسبق الإجراء، وOverwrite في الوحدة 3 معطل. لا تضف معالج خطأ يتابع إلى الإجراء بعد فشل الحجز.</li><li>اختبر Run once ببيانات تجريبية في حسابك قبل التفعيل. إذا بقي سجل pending بعد خطأ أو مهلة، راجع الوجهة أولاً قبل حذف الحجز أو إعادة المحاولة. لا يوجد ضمان إرسال مرة واحدة عند إعادة تشغيل إجراء يدوياً.</li><li>الملف ينشئ وحدات وربط حقول عند استيراده؛ الاتصالات والمخزن والجدولة والتفعيل خطوات ينجزها صاحب الحساب.</li></ol>",
        "isFilterNote": false,
        "metadata": {
          "color": "#2e7059"
        }
      }
    ]
  }
}